# Why: audio files are ~35 MB each and live in the team Google Drive instead.
*.wav
*.mp3
*.m4a
*.flac

# Why: each person builds their own Python environment from requirements.txt.
.venv/

# Why: scratch folders hold temporary attacked files, not results.
attacked/
aseal/marked/
aseal/tmp/

# Why: watermark keys are secrets; never publish them.
*.key

# Why: Mac system clutter.
.DS_Store
__pycache__/

# Why: Demucs (stem splitting) gets its own environment, also rebuilt locally.
.venv-demucs/

# Why: edited copies for Gemini uploads are regenerated by make_synthid_copies.py.
synthid_copies/

# Why: ViSQOL (visqol-python) gets its own environment, rebuilt locally.
.venv-visqol/
